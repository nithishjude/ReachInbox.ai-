# ---------- Server ----------
PORT=4000
# Where the React app runs (used for CORS + post-login redirect)
FRONTEND_URL=http://localhost:5173
# Long random string used to sign session JWTs
JWT_SECRET=change-me-to-a-long-random-string

# ---------- Infra ----------
DATABASE_URL=postgres://reachinbox:reachinbox@localhost:5432/reachinbox
REDIS_URL=redis://localhost:6379

# ---------- Google OAuth ----------
# Create an OAuth 2.0 Client ID (type "Web application") in Google Cloud Console.
# Authorized redirect URI must be exactly GOOGLE_REDIRECT_URI below.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/api/auth/google/callback

# ---------- Senders (Ethereal SMTP) ----------
# Option A (default): leave ETHEREAL_SENDERS empty and the server creates
# ETHEREAL_SENDER_COUNT Ethereal test accounts on first boot and stores them in Postgres.
ETHEREAL_SENDER_COUNT=3
# Option B: pin your own Ethereal accounts as JSON:
# ETHEREAL_SENDERS=[{"name":"Alice","user":"alice@ethereal.email","pass":"xxxx"},{"name":"Bob","user":"bob@ethereal.email","pass":"yyyy"}]
ETHEREAL_SENDERS=

# ---------- Optional: real delivery (e.g. Gmail) ----------
# Adds senders that deliver to REAL inboxes; they appear in the compose "From" dropdown as "real delivery".
# Gmail: enable 2-Step Verification, create an App Password (https://myaccount.google.com/apppasswords)
# and use it as "pass" (NOT your normal password). host/port/secure default to smtp.gmail.com:465 SSL.
# Gmail caps ~500 emails/day; keep MAX_EMAILS_PER_HOUR_PER_SENDER low for real senders.
# SMTP_SENDERS=[{"name":"Your Name","user":"you@gmail.com","pass":"abcd efgh ijkl mnop"}]
SMTP_SENDERS=

# ---------- Worker / throughput ----------
# Jobs processed in parallel per worker process
WORKER_CONCURRENCY=5
# Minimum gap between two sends from the SAME sender (ms), enforced in Redis
MIN_DELAY_BETWEEN_SENDS_MS=2000
# Hard cap per sender per clock-hour, enforced in Redis (applies on top of each batch's own hourly limit)
MAX_EMAILS_PER_HOUR_PER_SENDER=200
# Attempts for transient SMTP/network errors (exponential backoff 30s, 60s, 2m, 4m)
SEND_MAX_ATTEMPTS=5

# Run the BullMQ worker inside the API process when using `npm run dev` / `npm start`
RUN_WORKER_IN_API=true


# ---------- Admin ----------
# Comma-separated Google account emails allowed to open the BullMQ dashboard (/admin/queues).
ADMIN_EMAILS=you@example.com

